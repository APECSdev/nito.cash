{
  "name": "nito.cash",
  "version": "20.4.18",
  "private": true,
  "description": "Nito.cash — Hush Your Money. A Bitcoin Cash privacy wallet (web app) with a Halo 2 / Orchard ZK prover (Cloudflare Worker).",
  "workspaces": [
    "apps/*",
    "workers/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @nito.cash/web run serve",
    "build": "pnpm --filter @nito.cash/web run build-for-all",
    "build:web": "pnpm --filter @nito.cash/web run build-for-all",
    "lint": "pnpm --filter @nito.cash/web run lint",
    "test:unit": "pnpm --filter @nito.cash/web run test:unit",
    "prover:dev": "pnpm --filter @nito.cash/prover run dev",
    "prover:deploy": "bash scripts/deploy-prover.sh",
    "prover:build-wasm": "pnpm --filter @nito.cash/prover run build:wasm"
  }
}
