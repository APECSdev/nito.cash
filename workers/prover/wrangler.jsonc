// wrangler.jsonc
//
// Cloudflare Worker configuration for the Nito.cash proving service.
//
// This service is shared across Nito.cash clients. It is vendored from the
// Sansbank `wasm-prover` project (history intentionally dropped) and deployed
// at `prover.nito.cash`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nito-prover",
  "main": "src/index.js",
  "compatibility_date": "2025-01-29",
  "compatibility_flags": ["nodejs_compat"],

  // A custom domain, not a route pattern. `prover.nito.cash` is a hostname
  // in the `nito.cash` zone (the same Cloudflare account), and
  // `custom_domain` makes Wrangler create the DNS record AND the certificate
  // for it. A bare route would need that record to exist already.
  "routes": [
    {
      "pattern": "prover.nito.cash",
      "custom_domain": true
    }
  ],

  // NOTE: the original config set `limits.cpu_ms = 300000` so the Halo 2 proving
  // key (~30-50 s `OnceLock` build per isolate) could complete. CPU limits are a
  // PAID-plan feature; Cloudflare rejects the deploy on the Free plan with
  // code 100328 ("CPU limits are not supported for the Free plan"). It is removed
  // here so the deploy succeeds on the current plan — restore this block once the
  // account is upgraded, since Free-plan CPU time is too low for keygen.
  // "limits": {
  //   "cpu_ms": 300000
  // },

  // The wasm is imported as a static module so workerd links it at deploy time.
  // `WebAssembly.compile()` at runtime is disallowed in workerd.
  "rules": [
    {
      "type": "CompiledWasm",
      "globs": ["**/*.wasm"],
      "fallthrough": true
    }
  ],

  "observability": {
    "enabled": true
  }
}
